name: MiBici

python_env: python_env.yaml

entry_points:
  main:
    parameters:
      question : {type: string, default: all}
    command: >-
      python -m MiBici.dataset
      && python -m MiBici.features
      && python -m MiBici.modeling.train main
      --question {question}

  ingest:
    parameters:
      desde: {type: string, default: "2024-01"}
      hasta: {type: string, default: "2025-12"}
    command: >-
      python -m MiBici.dataset 
      --desde {desde} 
      --hasta {hasta}

  ingest_monitoreo:
    command: python -m MiBici.dataset monitoreo

  monitoring:
    command: python -m MiBici.monitoring.datasets

  drift:
    parameters:
      tau: {type: float, default: 0.15}
    command: >-
      python -m MiBici.monitoring.drift --reference data/processed/monitoring/reference.parquet
      --current data/processed/monitoring/current.parquet --estaciones todas
      && python -m MiBici.monitoring.drift --reference data/processed/monitoring/reference.parquet
      --current data/processed/monitoring/current.parquet --estaciones existentes
      && python -m MiBici.monitoring.drift --reference data/processed/monitoring/reference.parquet
      --current data/processed/monitoring/current.parquet --estaciones nuevas
      && python -m MiBici.monitoring.clasificacion --tau {tau}
      && python -m MiBici.monitoring.importancia --tau {tau}
      && python -m MiBici.monitoring.figuras

  ab_test:
    command: python -m MiBici.monitoring.ab_test

  ct_policy:
    command: python -m MiBici.monitoring.ct_policy

  monitor:
    parameters:
      tau: {type: float, default: 0.15}
    command: >-
      python -m MiBici.dataset monitoreo
      && python -m MiBici.monitoring.datasets --tau {tau}
      && python -m MiBici.monitoring.drift --reference data/processed/monitoring/reference.parquet
      --current data/processed/monitoring/current.parquet --estaciones todas
      && python -m MiBici.monitoring.drift --reference data/processed/monitoring/reference.parquet
      --current data/processed/monitoring/current.parquet --estaciones existentes
      && python -m MiBici.monitoring.drift --reference data/processed/monitoring/reference.parquet
      --current data/processed/monitoring/current.parquet --estaciones nuevas
      && python -m MiBici.monitoring.clasificacion --tau {tau}
      && python -m MiBici.monitoring.importancia --tau {tau}
      && python -m MiBici.monitoring.figuras
      && python -m MiBici.monitoring.ab_test
      && python -m MiBici.monitoring.ct_policy

  train:
    parameters:
      question : {type: string, default: all}
      model: {type: string, default: none}
    command: >-
      python -m MiBici.modeling.train main
      --question {question}
      --model {model}

  search:
    parameters:
      question : {type: string, default: "p1"}
      model: {type: string, default: none}
    command: >-
      python -m MiBici.modeling.train search
      --question {question}
      --model {model}

  register:
    parameters:
      question: {type: string}
      run_id: {type: string}
      alias: {type: string, default: champion}
    command: >-
      python -m MiBici.modeling.register
      --question {question}
      --run-id {run_id}
      --alias {alias}